# Copy to .env.local for development, and set these in the Vercel project.

# This site's own origin. Used for canonical URLs, the sitemap, and og:url.
NEXT_PUBLIC_SITE_ORIGIN=https://useyukti.in

# The product. Every "Use Yukti now" CTA points here. Deployed separately —
# this site must never link to its own origin for signup.
NEXT_PUBLIC_SIGNUP_URL=https://app.useyukti.in
# Seller = the business running Yukti. Dealer = their customer.
NEXT_PUBLIC_SELLER_LOGIN_URL=https://app.useyukti.in
NEXT_PUBLIC_DEALER_LOGIN_URL=https://app.useyukti.in

# Digits only, country code included (wa.me path format).
NEXT_PUBLIC_WHATSAPP_NUMBER=919490744841

# PostHog. Shares the existing project; split dashboards by host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
